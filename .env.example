# Copy to .env and fill in. Never commit .env.

# Ring Developer Playground -> Generate token. Valid for 30 minutes.
RING_ACCESS_TOKEN=paste-playground-token-here
RING_API_BASE=https://api.amazonvision.com

# SQLite database path (git-ignored)
THRESHOLD_DB=data/threshold.db

# MCP server bind (snapshot URLs use PUBLIC_BASE_URL, default http://MCP_HOST:MCP_PORT)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Household routine (used when the household is first created in the DB)
THRESHOLD_HOUSEHOLD=home
THRESHOLD_PARENT_NAME=Dad
THRESHOLD_TZ=Asia/Kolkata
THRESHOLD_CHECKIN_BY=10:00
THRESHOLD_GRACE_MIN=30
THRESHOLD_REPROMPT_MIN=10
THRESHOLD_SECONDARY_AFTER_MIN=20
